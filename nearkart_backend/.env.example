# ==============================================================
# NEARKART — ENVIRONMENT VARIABLES
# ==============================================================
# HOW TO USE:
#   cp .env.example .env
#   Fill every value — do NOT leave any as placeholder
#   NEVER commit .env to Git (it is in .gitignore)
#   For production use AWS Secrets Manager (Sprint 12)
# ==============================================================

# ── DJANGO ─────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-50-char-secret-key-generate-with-command-below
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Generate SECRET_KEY:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ── DATABASE ───────────────────────────────────────────────────
DB_NAME=nearkart
DB_USER=nearkart
DB_PASSWORD=nearkart_dev_password_change_in_prod
DB_HOST=postgres
DB_PORT=5432

# ── REDIS ──────────────────────────────────────────────────────
# db=0 → Celery broker (keep separate from cache)
# db=1 → Django cache
# db=2 → Django Channels layer
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_CHANNEL_URL=redis://redis:6379/2

# REDIS_PASSWORD is required in production (leave blank for dev Docker)
REDIS_PASSWORD=

# ── JWT ────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ── AWS ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nearkart-media-dev
# AWS_S3_STATIC_BUCKET is used in production to serve collectstatic output via S3
AWS_S3_STATIC_BUCKET=nearkart-static-dev
AWS_CDN_DOMAIN=nearkart-media-dev.s3.ap-south-1.amazonaws.com
AWS_PRESIGNED_URL_EXPIRY=900

# ── TWILIO (SMS OTP) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# ── FIREBASE (FCM PUSH) ────────────────────────────────────────
FIREBASE_CREDENTIALS_JSON=/app/firebase-credentials.json

# ── SENDGRID (EMAIL) ───────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
DEFAULT_FROM_EMAIL=hello@nearkart.in
DEFAULT_FROM_NAME=NearKart

# ── RAZORPAY (Payment Gateway) ────────────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_*) for dev, live keys (rzp_live_*) for production
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER_SECRET
# Get webhook secret from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_WEBHOOK_SECRET

# ── GOOGLE MAPS ────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSyYour_Google_Maps_API_Key_Here

# ── SENTRY ─────────────────────────────────────────────────────
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development

# ── CORS ───────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,http://127.0.0.1:3000

# ── CELERY ─────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=Asia/Kolkata

# ── RATE LIMITING ──────────────────────────────────────────────
OTP_SEND_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10
VIDEO_UPLOAD_RATE_LIMIT=10

# ── BUSINESS LOGIC CONSTANTS ───────────────────────────────────
BLACKLIST_INACTIVE_DAYS=30
BLACKLIST_WARNING_DAY=20
BLACKLIST_FINAL_WARNING_DAY=27
RESERVATION_HOLD_HOURS=2
VIDEO_MAX_DURATION_SECONDS=60
STORY_MAX_DURATION_SECONDS=30
VIDEO_MAX_SIZE_MB=100
STORY_MAX_SIZE_MB=50
STORY_EXPIRY_HOURS=24
VIDEO_EXPIRY_DAYS=30

# ── GUNICORN (production tuning) ──────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_LOG_LEVEL=info

# ── DEVELOPMENT ONLY ───────────────────────────────────────────
# Fixed OTP bypasses Twilio in dev. REMOVE in production (set empty).
DEV_FIXED_OTP=123456
DEBUG_SQL=False
